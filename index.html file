<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Timothy's iPad System</title>

<style>
body{
    margin:0;
    width:100vw;
    height:100vh;
    background:#0f172a;
    color:white;
    font-family:Arial,sans-serif;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    overflow:hidden;
}

.live{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    color:red;
    font-size:4vw;
    font-weight:bold;
    margin-bottom:20px;
}

.dot{
    width:24px;
    height:24px;
    background:red;
    border-radius:50%;
    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    0%{
        opacity:1;
        transform:scale(1);
    }
    50%{
        opacity:.5;
        transform:scale(1.3);
    }
    100%{
        opacity:1;
        transform:scale(1);
    }
}

h1{
    font-size:7vw;
    color:#38bdf8;
    margin:0;
}

#clock{
    font-size:15vw;
    font-weight:bold;
    line-height:1;
    margin-top:10px;
}

#location{
    font-size:4vw;
    color:#94a3b8;
    margin-top:15px;
}
</style>
</head>

<body>

<div class="live">
    <span class="dot"></span>
    LIVE
</div>

<h1>📱 Timothy's iPad System</h1>

<div id="clock">Loading...</div>

<div id="location">🇵🇭 Philippines Time</div>

<script>
function updateTime() {
    const phTime = new Date().toLocaleTimeString("en-US", {
        timeZone: "Asia/Manila",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
    });

    document.getElementById("clock").textContent = phTime;
}

updateTime();
setInterval(updateTime, 1000);
</script>

</body>
</html>
