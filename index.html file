<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Timothy's iPad System</title>

<style>
body{
    margin:0;
    background:#0f172a;
    color:white;
    font-family:Arial,sans-serif;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    height:100vh;
    text-align:center;
}

.live{
    display:flex;
    align-items:center;
    gap:10px;
    color:red;
    font-size:35px;
    font-weight:bold;
}

.dot{
    width:25px;
    height:25px;
    background:red;
    border-radius:50%;
    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    0%{opacity:1;transform:scale(1);}
    50%{opacity:.4;transform:scale(1.3);}
    100%{opacity:1;transform:scale(1);}
}

h1{
    color:#38bdf8;
    font-size:65px;
}

#clock{
    font-size:120px;
    font-weight:bold;
    text-shadow:0 0 20px #38bdf8;
}

#date{
    font-size:35px;
    color:#cbd5e1;
}

#location{
    font-size:30px;
    color:#94a3b8;
}

.status{
    margin-top:20px;
    font-size:24px;
    color:#4ade80;
}
</style>
</head>

<body>

<div class="live">
    <div class="dot"></div>
    LIVE
</div>

<h1>📱 Timothy's iPad System</h1>

<div id="clock"></div>
<div id="date"></div>
<div id="location">🇵🇭 Philippines Time (Asia/Manila)</div>

<div class="status">
🟢 Online • Updating Every Second
</div>

<script>
function updateDashboard() {
    const now = new Date();

    const time = now.toLocaleTimeString("en-US", {
        timeZone: "Asia/Manila",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
    });

    const date = now.toLocaleDateString("en-US", {
        timeZone: "Asia/Manila",
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric"
    });

    document.getElementById("clock").textContent = time;
    document.getElementById("date").textContent = date;
}

updateDashboard();
setInterval(updateDashboard, 1000);
</script>

</body>
</html>
